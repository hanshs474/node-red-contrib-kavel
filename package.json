  "keywords": ["node-red", "kavel", "ai", "image-generation", "text-to-image", "image-editing"],
  "homepage": "https://www.kavel.ai/?utm_source=nodered&utm_medium=package",
  "repository": { "type": "git", "url": "git+https://github.com/hanshs474/node-red-contrib-kavel.git" },
  "bugs": { "url": "https://github.com/hanshs474/node-red-contrib-kavel/issues" },
  "license": "MIT",
  "author": "Kavel <support@kavel.ai>",
  "engines": { "node": ">=18" },
  "node-red": {
    "version": ">=3.0.0",
    "nodes": { "kavel-image": "kavel.js" }
  },
  "files": ["kavel.js", "kavel.html", "examples", "icons", "README.md", "LICENSE"]
}
